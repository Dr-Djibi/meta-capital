{
  "expo": {
    "name": "Meta Capital",
    "slug": "meta-capital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/meta-capital-icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/meta-capital-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08111F",
        "foregroundImage": "./assets/images/meta-capital-icon.png",
        "monochromeImage": "./assets/images/meta-capital-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/meta-capital-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08111F",
          "image": "./assets/images/meta-capital-splash.png",
          "imageWidth": 180
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
